<Window x:Class="RouteFinder.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RouteFinder">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#101018">
        <Grid.Resources>
            <SolidColorBrush x:Key="CardFill" Color="#1B1B28" />
            <SolidColorBrush x:Key="CardBorder" Color="#353549" />
            <SolidColorBrush x:Key="SubtleText" Color="#B4B3CA" />
            <SolidColorBrush x:Key="AccentText" Color="#C2B3FF" />
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowHeader" Background="#151520">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0" VerticalAlignment="Center">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="7" Canvas.Top="7" Width="242" Height="242" RadiusX="57" RadiusY="57"
                                   Fill="#2D214A" Stroke="#64518B" StrokeThickness="5" />
                        <Path Data="M 57,169 L 113,104 L 155,142 L 199,78" Stroke="#CFBCFF" StrokeThickness="16" />
                        <Ellipse Canvas.Left="45" Canvas.Top="157" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                        <Ellipse Canvas.Left="101" Canvas.Top="92" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                        <Ellipse Canvas.Left="143" Canvas.Top="130" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                        <Ellipse Canvas.Left="187" Canvas.Top="66" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="RouteFinder" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="PreviewLabel" Text="DESIGN PREVIEW" Foreground="{StaticResource AccentText}" FontSize="10"
                           FontWeight="SemiBold" CharacterSpacing="100" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="24,14,24,16" MaxWidth="1100" RowSpacing="10" SizeChanged="ResizeCards">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="App router" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="AccountButton" Content="Sign in to EZConnect" Click="ToggleAccount" />
                    <Button x:Name="ActivityButton" Content="Activity" Click="OpenActivity" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="OpenSettings" />
                    <Button x:Name="AdvancedButton" Content="Advanced tools" Click="OpenAdvancedTools" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" />
            <Grid x:Name="Cards" Grid.Row="2" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" /><ColumnDefinition x:Name="RouteColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" /><RowDefinition x:Name="StackedRouteRow" Height="0" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="What to route" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="AddAppsButton" Grid.Column="1" Content="Add app">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Choose a running app" Click="PickRunningApp" />
                                        <MenuFlyoutItem Text="Browse for an executable…" Click="BrowseForApp" />
                                        <MenuFlyoutItem Text="Browse EZConnect game and app catalog…" Click="OpenCatalog" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <RadioButtons x:Name="Scope" Grid.Row="1" MaxColumns="2" SelectedIndex="0" SelectionChanged="ScopeChanged"
                                      AutomationProperties.Name="Traffic scope">
                            <x:String>Selected apps</x:String>
                            <x:String>Entire PC</x:String>
                        </RadioButtons>
                        <TextBlock x:Name="AppSummary" Grid.Row="2" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="AppScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AppRows" Spacing="5" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="RouteCard" Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Where to connect" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border Background="#242437" CornerRadius="12" Padding="12,8">
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="RouteTitle" Text="No route selected" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <Border x:Name="SourceBadge" Background="#383059" CornerRadius="5"
                                        HorizontalAlignment="Left" Padding="8,2" Visibility="Collapsed">
                                    <TextBlock x:Name="RouteSource" Foreground="#E0D4FF" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="RouteDetail" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ChooseRouteButton" Content="Choose route" Click="PickRoute" />
                            <Button x:Name="AddRouteButton" Content="Add route">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Import config…" Click="ImportConfig" />
                                        <MenuFlyoutItem x:Name="AccountCommand" Text="Add EZConnect account…" Click="ToggleAccount" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="TestRouteButton" Content="Test route" Click="TestSelectedRoute" />
                            <Button x:Name="TestAllButton" Content="Test all routes" Click="TestAllRoutes" />
                            <Button x:Name="RouteToolsButton" AutomationProperties.Name="More route tools"
                                    ToolTipService.ToolTip="More route tools">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="CompareButton" Text="Compare routes" Click="CompareRoutes">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="DestinationButton" Text="Test destination…" Click="TestCustomDestination">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="RouteOptionsButton" Text="Route options" Click="OpenRouteOptions">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ConnectionBar" Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Background="#28203D">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionTitle" Text="Disconnected" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ConnectionDetail" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="ConnectionActionsButton" Grid.Column="1" Click="OpenConnectionOptions"
                            AutomationProperties.Name="Connection options" ToolTipService.ToolTip="Connection options">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                    <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Click="ToggleConnection"
                            Style="{StaticResource AccentButtonStyle}" Background="#C3B1FF" Foreground="#201638"
                            MinWidth="100" Padding="12,8" CornerRadius="9" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
