<Window x:Class="RouteFinder.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RouteFinder.WinUI"
        Title="RouteFinder">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
            <!-- Accent brushes and solid primary buttons. Set here (not in App.xaml) so control templates pick them up. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF5A6EE8" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF6A7DEE" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF4C5FD6" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFA9B6FF" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFA9B6FF" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF8A9BF5" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF5A6EE8" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF6A7DEE" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF4C5FD6" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#1FFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF3F51D6" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF4B5EE0" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF3747C2" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF3342B8" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF3342B8" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF3F51D6" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF3F51D6" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF4B5EE0" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF3747C2" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#26000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#1A000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Shared look. Theme brushes (BrandCardFill, BrandTileFill, BrandMetricFill...) live in App.xaml. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BrandCardFill}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandCardEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="AppRow" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource BrandCardFill}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandCardEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="52" />
            </Style>
            <Style x:Key="PageHeader" TargetType="Grid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,4,0,18" />
            </Style>
            <Style x:Key="PageHeaderBorder" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,4,0,18" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource BrandTitleText}" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,8,0,2" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Metric" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource BrandTitleText}" />
            </Style>
            <local:ToneBrushConverter x:Key="ToneBrush" />
            <!-- Rounded square behind an icon or badge, used by every list row. -->
            <Style x:Key="IconTile" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{ThemeResource BrandTileFill}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconTileGrid" TargetType="Grid">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Background" Value="{ThemeResource BrandTileFill}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TileGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Solid brand tile with a white glyph, for page banners and provider cards. -->
            <Style x:Key="HeroTile" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource BrandTileFill}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HeroGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="MetricTile" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BrandMetricFill}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BrandCardEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <!-- A full-width row that behaves like a link: hover highlight, chevron on the right. -->
            <Style x:Key="RowButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <DataTemplate x:Key="RoutePickerRowTemplate">
                <Grid ColumnSpacing="14" Padding="6,10" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}">
                        <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Right"
                                Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=background}">
                            <TextBlock Text="{Binding Result}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding TestAge}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="WindowHeader" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="7" Canvas.Top="7" Width="242" Height="242" RadiusX="57" RadiusY="57"
                                   Fill="{StaticResource BrandSolid}" />
                        <Path Data="M 57,169 L 113,104 L 155,142 L 199,78" Stroke="White" StrokeThickness="18" />
                        <Ellipse Canvas.Left="45" Canvas.Top="157" Width="24" Height="24" Fill="White" />
                        <Ellipse Canvas.Left="187" Canvas.Top="66" Width="24" Height="24" Fill="White" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="RouteFinder" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border x:Name="PreviewLabel" Visibility="Collapsed" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" IsPaneToggleButtonVisible="True" OpenPaneLength="132"
                        CompactModeThresholdWidth="560" ExpandedModeThresholdWidth="960"
                        SelectionChanged="NavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="Home" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavApps" Content="Apps" Tag="apps">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavRoutes" Content="Routes" Tag="routes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE909;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavProviders" Content="Providers" Tag="providers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavNetwork" Content="Network" Tag="network">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavActivity" Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="Workspace">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Progress for any running operation, visible from every page. -->
                <StackPanel x:Name="BusyStrip" Visibility="Collapsed" Spacing="4" Margin="32,12,32,0">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Text, ElementName=ConnectionTitle}" />
                        <Run Text="  " />
                        <Run Text="{Binding Text, ElementName=ConnectionDetail}" />
                    </TextBlock>
                </StackPanel>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="32,12,32,0" />

                <!-- HOME -->
                <!-- The whole Home layout scales as one piece, so spacing stays equal on every side at any window size. -->
                <Grid x:Name="HomePage" Grid.Row="2" Padding="24">
                    <Viewbox x:Name="HomeScale" Stretch="Uniform" StretchDirection="Both" MaxWidth="1180" MaxHeight="900"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="HomeContent" Width="760" Spacing="12">
                        <Grid x:Name="StatusCard">
                            <Border Style="{StaticResource Card}" />
                            <!-- Soft color wash that reflects the connection state. -->
                            <Border x:Name="StatusGlow" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.4" /></Border.OpacityTransition>
                            </Border>
                            <Grid Padding="24,18" ColumnSpacing="20" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <StackPanel VerticalAlignment="Center" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                        <TextBlock x:Name="StatusLabel" Text="NOT CONNECTED" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="ConnectionTitle" Text="Disconnected" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource BrandTitleText}"
                                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="ConnectionDetail" Style="{StaticResource Secondary}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="ConnectionActionsButton" Margin="-10,4,0,0" Padding="10,6" Click="OpenConnectionOptions"
                                            Background="Transparent" BorderThickness="0" AutomationProperties.Name="More connection actions">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="More actions" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel x:Name="InlineConnectionActions" Spacing="4" MinWidth="220">
                                                    <Button x:Name="ReconnectInline" Content="Reconnect" Click="ReconnectFromPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                    <Button x:Name="WatchInline" Content="Watch apps" Click="WatchFromPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            ToolTipService.ToolTip="Connect automatically when a selected app starts." />
                                                    <Button x:Name="HoldInline" Content="Hold open" Click="HoldFromPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                    <Button x:Name="HotspotInline" Content="Hotspot and console" Click="HotspotFromPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                    <Button x:Name="ProbeInline" Content="Probe a destination" Click="ProbeFromPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                    <Button x:Name="ResetInline" Content="Reset TCP connections" Click="ResetFromPanel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>

                                <!-- Round connect button inside a state-colored ring. -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Border x:Name="ConnectRing" Width="112" Height="112" CornerRadius="56" BorderThickness="2"
                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                                    <Button x:Name="ConnectButton" Content="Connect" Click="ToggleConnection"
                                            Style="{StaticResource AccentButtonStyle}" Width="92" Height="92" CornerRadius="46" Padding="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                </Border>
                                </Grid>

                                <Grid x:Name="Metrics" Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MetricTile}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Latency" Style="{StaticResource Caption}" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="LiveRtt" Text="—" Style="{StaticResource Metric}" />
                                                <Polyline x:Name="LatencyTrend" Grid.Column="1" Width="94" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                          Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                                          Visibility="Collapsed"
                                                          ToolTipService.ToolTip="Recent WireSock peer RTT estimates. The scale adjusts to the visible range." />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Est. loss" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="LiveLoss" Text="—" Style="{StaticResource Metric}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource MetricTile}"
                                            ToolTipService.ToolTip="Mean change between consecutive WireSock RTT estimates. This is an estimate trend, not packet-level jitter.">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="RTT variation" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="LiveVariation" Text="—" Style="{StaticResource Metric}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2" Margin="0,-8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="UsageIcon" Glyph="&#xE8AB;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LiveUsage" Text="" Style="{StaticResource Secondary}"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="LivePeer" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="20,0,0,0" />
                                    <HyperlinkButton x:Name="HealthAlert" Visibility="Collapsed" Click="OpenActivity" Padding="0,6,0,0"
                                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock x:Name="HealthMessage" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <StackPanel x:Name="SetupPanel" Spacing="10">
                        <TextBlock Text="Setup" Style="{StaticResource SectionLabel}" Margin="2,2,0,0" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Button Style="{StaticResource RowButton}" Padding="20,8" Click="GoToRoutes" AutomationProperties.Name="Change route">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE909;" Style="{StaticResource TileGlyph}" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Route" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="HomeRouteTitle" Text="No route selected" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="72,0,0,0" />
                                <Button Style="{StaticResource RowButton}" Padding="20,8" Click="GoToApps" AutomationProperties.Name="Manage apps">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE71D;" Style="{StaticResource TileGlyph}" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Apps" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="HomeAppsSummary" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="72,0,0,0" />
                                <Grid Padding="20,8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><FontIcon Glyph="&#xE8AB;" Style="{StaticResource TileGlyph}" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="What goes through the route" Style="{StaticResource Caption}" />
                                        <RadioButtons x:Name="Scope" MaxColumns="3" SelectedIndex="0" SelectionChanged="ScopeChanged"
                                                      AutomationProperties.Name="Traffic scope">
                                            <x:String>Selected apps</x:String>
                                            <x:String>Entire PC</x:String>
                                            <x:String>Selected apps only</x:String>
                                        </RadioButtons>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                    </Viewbox>
                </Grid>

                <!-- APPS -->
                <Grid x:Name="AppsPage" Grid.Row="2" Visibility="Collapsed" Margin="32,24,32,24" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Style="{StaticResource PageHeader}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xE71D;" Style="{StaticResource HeroGlyph}" /></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="AddAppsButton" Grid.Column="2" Content="Add app" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Choose a running app" Click="PickRunningApp" />
                                    <MenuFlyoutItem Text="Choose a background process" Click="PickBackgroundApp" />
                                    <MenuFlyoutItem Text="Browse for an executable…" Click="BrowseForApp" />
                                    <MenuFlyoutItem x:Name="CatalogCommand" Text="Browse EZConnect game and app catalog…" Click="OpenCatalog" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="10">
                        <!-- Where "Through VPN" apps go, and whether that is happening right now. -->
                        <Border x:Name="VpnBar" Style="{StaticResource Card}" Padding="16,12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}">
                                    <Ellipse x:Name="VpnBarDot" Width="10" Height="10" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="VpnBarTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="VpnBarDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="VpnBarButton" Grid.Column="2" VerticalAlignment="Center" Click="VpnBarClicked" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AppSummary" Style="{StaticResource Secondary}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <ScrollViewer x:Name="AppScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AppRows" Spacing="6" Padding="0,0,12,0" />
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyApps" Spacing="8" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE71D;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="No apps yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Shown only while apps are pinned to an adapter; applies those rules. -->
                    <Border x:Name="AdapterRulesBar" Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Visibility="Collapsed">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE968;" Style="{StaticResource TileGlyph}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="WindowsRoutingStatus" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- NETWORK -->
                <ScrollViewer x:Name="NetworkPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="32,24,32,32">
                        <Border Style="{StaticResource PageHeaderBorder}"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xE968;" Style="{StaticResource HeroGlyph}" /></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Network" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                        </StackPanel></Border>

                        <TextBlock Text="Default adapter" Style="{StaticResource SectionLabel}" Margin="2,12,0,2" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="WindowsFallbackAdapter" Header="Adapter for apps without a rule" HorizontalAlignment="Stretch"
                                              SelectionChanged="WindowsFallbackChanged" />
                                    <Button x:Name="RefreshWindowsAdaptersButton" Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshWindowsAdapters"
                                            AutomationProperties.Name="Refresh adapters" ToolTipService.ToolTip="Refresh adapters">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </Grid>
                                <ToggleSwitch x:Name="KeepWindowsDefaultToggle" Header="Keep as Windows default" OffContent="Only while RouteFinder runs" OnContent="Also after RouteFinder closes"
                                              Toggled="KeepWindowsDefaultChanged"
                                              ToolTipService.ToolTip="Make this adapter Windows' preferred adapter permanently. Choose Follow Windows to undo it." />
                                <TextBlock x:Name="WindowsDefaultAdapter" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Interfaces and DNS" Style="{StaticResource SectionLabel}" Margin="2,12,0,2" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <ComboBox x:Name="InterfacePicker" Header="Interface" HorizontalAlignment="Stretch" SelectionChanged="InterfaceChanged" />
                                <Grid x:Name="InterfaceFacts" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Style="{StaticResource MetricTile}"><StackPanel Spacing="2"><TextBlock Text="Status" Style="{StaticResource Caption}" /><TextBlock x:Name="InterfaceStatus" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" /></StackPanel></Border>
                                    <Border Grid.Column="1" Style="{StaticResource MetricTile}"><StackPanel Spacing="2"><TextBlock Text="Gateway" Style="{StaticResource Caption}" /><TextBlock x:Name="InterfaceGateway" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel></Border>
                                    <Border Grid.Row="1" Style="{StaticResource MetricTile}"><StackPanel Spacing="2"><TextBlock Text="Addresses" Style="{StaticResource Caption}" /><TextBlock x:Name="InterfaceAddresses" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricTile}"><StackPanel Spacing="2"><TextBlock Text="Current DNS" Style="{StaticResource Caption}" /><TextBlock x:Name="InterfaceDns" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel></Border>
                                </Grid>
                                <local:DnsEditor x:Name="DnsInput" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ApplyDnsButton" Content="Apply DNS" Style="{StaticResource AccentButtonStyle}" Click="ApplyDnsClicked" />
                                    <Button x:Name="AutoDnsButton" Content="Use automatic DNS" Click="AutoDnsClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tools" Style="{StaticResource SectionLabel}" Margin="2,12,0,2" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Button Style="{StaticResource RowButton}" Click="InspectAppRouting" AutomationProperties.Name="Live routing inspector">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE9D9;" Style="{StaticResource TileGlyph}" /></Border>
                                        <TextBlock Grid.Column="1" Text="Live routing inspector" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="Each app's connections and the interface they use" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="72,0,0,0" />
                                <Button x:Name="Ipv6Button" Style="{StaticResource RowButton}" Click="ConfigureIpv6Clicked" AutomationProperties.Name="IPv6 adapter bindings">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE968;" Style="{StaticResource TileGlyph}" /></Border>
                                        <TextBlock Grid.Column="1" Text="IPv6 adapter bindings" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="Turn IPv6 on or off for active adapters" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PROVIDERS -->
                <ScrollViewer x:Name="ProvidersPage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="32,24,32,32">
                        <Border Style="{StaticResource PageHeaderBorder}"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xEA86;" Style="{StaticResource HeroGlyph}" /></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Providers" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                        </StackPanel></Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HeroTile}"><TextBlock Text="EZ" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="EZConnect" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="EzStatus" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border x:Name="EzBadge" Grid.Column="2" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="EzBadgeText" Text="Not signed in" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="EzDetail" Style="{StaticResource Secondary}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="EzSignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" Click="ToggleAccount" />
                                    <Button x:Name="EzRetryButton" Content="Use saved sign-in" Click="RetrySavedSignIn" />
                                    <Button x:Name="EzRefreshButton" Content="Refresh routes" Click="RefreshProviderRoutes" />
                                    <Button x:Name="EzCatalogButton" Content="Game catalog" Click="OpenCatalog" />
                                    <Button x:Name="EzAccountButton" Content="Account" Click="ToggleAccount" />
                                    <Button x:Name="EzSignOutButton" Content="Sign out" Click="SignOutProvider" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xE8E5;" Style="{StaticResource HeroGlyph}" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Imported configurations" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="ImportedBadgeText" Text="0 routes" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ImportProviderButton" Content="Import configuration…" Style="{StaticResource AccentButtonStyle}" Click="ImportConfig" />
                                    <Button Content="View routes" Click="GoToRoutes" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ROUTES -->
                <Grid x:Name="RoutesPage" Grid.Row="2" Visibility="Collapsed" Margin="32,24,32,24" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Style="{StaticResource PageHeader}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xE909;" Style="{StaticResource HeroGlyph}" /></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Routes" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="AddRouteButton" Grid.Column="1" Content="Add route" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="ImportRouteCommand" Text="Import WireGuard or Amnezia configuration…" Click="ImportConfig" />
                                    <MenuFlyoutItem x:Name="AccountCommand" Text="Sign in to EZConnect…" Click="ToggleAccount" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBox x:Name="RouteSearch" Grid.Row="1" PlaceholderText="Search routes, regions, or sources" AutomationProperties.Name="Search routes" />
                    <Grid x:Name="RouteFilters" Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="RouteFilter" HorizontalAlignment="Stretch" AutomationProperties.Name="Route source" />
                        <ComboBox x:Name="RouteRegion" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Route region" />
                        <ComboBox x:Name="RouteSort" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort routes" />
                        <ToggleButton x:Name="RouteFavorites" Grid.Column="3" Content="☆" AutomationProperties.Name="Favorites only" ToolTipService.ToolTip="Favorites only" />
                    </Grid>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <ListView x:Name="RouteList" ItemTemplate="{StaticResource RoutePickerRowTemplate}" AutomationProperties.Name="Available routes">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <StackPanel x:Name="EmptyRouteLibrary" Spacing="8" Margin="24,48" HorizontalAlignment="Center" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE909;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="No routes yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="RouteListSummary" Grid.ColumnSpan="2" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="RouteTestActions" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="TestRouteButton" Content="Test route" Click="TestSelectedRoute" />
                            <Button x:Name="TestAllButton" Content="Test all" Click="TestAllRoutes" />
                            <Button x:Name="RouteToolsButton" AutomationProperties.Name="More route tools" ToolTipService.ToolTip="More route tools">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedRight">
                                        <MenuFlyoutItem x:Name="TestShortlistButton" Text="Test filtered routes…" Click="TestShortlist" />
                                        <MenuFlyoutItem x:Name="CompareButton" Text="Compare routes" Click="CompareRoutes">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="DestinationButton" Text="Test destination…" Click="TestCustomDestination">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="ClearTestsButton" Text="Clear all saved test results…" Click="ClearTestsClicked">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="RouteOptionsButton" Text="Edit, export, or remove…" Click="OpenRouteOptions">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ACTIVITY -->
                <Grid x:Name="ActivityPage" Grid.Row="2" Visibility="Collapsed" Margin="32,24,32,24" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Style="{StaticResource PageHeader}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xE9D9;" Style="{StaticResource HeroGlyph}" /></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Activity" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="CopyActivityButton" Grid.Column="1" Content="Copy" Click="CopyActivity"  VerticalAlignment="Center"/>
                        <Button x:Name="SaveReportButton" Grid.Column="2" Content="Save report" Click="SaveReportClicked"  VerticalAlignment="Center"/>
                        <Button x:Name="OpenLogsButton" Grid.Column="3" Content="Open logs" Click="OpenLogsClicked" VerticalAlignment="Center" ToolTipService.ToolTip="Detailed log of routing, adapter rules, the tunnel and connections"/>
                        <Button x:Name="DiagnosticsButton" Grid.Column="4" Content="Diagnostics" Style="{StaticResource AccentButtonStyle}" Click="DiagnosticsClicked"  VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                        <Grid>
                            <ListView x:Name="ActivityList" SelectionMode="None" AutomationProperties.Name="Activity log">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,6" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyActivity" Text="Connection events will appear here." Style="{StaticResource Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Check per-app routing" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <Button x:Name="VerifyRoutingButton" Grid.Column="1" Content="Verify routing" ToolTipService.ToolTip="Compare public IPs from two browsers to confirm only the selected app uses the route" VerticalAlignment="Center" Click="ToggleRoutingVerification" />
                            </Grid>
                            <ScrollViewer x:Name="VerificationScroller" Visibility="Collapsed" MaxHeight="360"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Style="{StaticResource PageHeader}" Margin="32,24,32,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Style="{StaticResource HeroTile}"><FontIcon Glyph="&#xE713;" Style="{StaticResource HeroGlyph}" /></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SettingsResetButton" Grid.Column="1" Content="Discard changes" Click="DiscardSettings"  VerticalAlignment="Center"/>
                        <Button x:Name="SettingsSaveButton" Grid.Column="2" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveSettingsClicked"  VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="SettingsGate" IsTabStop="False" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="SettingsHost" Spacing="4" Margin="32,8,32,32" />
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
