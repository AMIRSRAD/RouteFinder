<Window x:Class="RouteFinder.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RouteFinder">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#101018">
        <Grid.Resources>
            <DataTemplate x:Key="RoutePickerRowTemplate">
                <Grid ColumnSpacing="10" Margin="0,7" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity=".75" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Result}" Foreground="#C9B9FF" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TestAge}" Foreground="#B4B3CA" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <SolidColorBrush x:Key="CardFill" Color="#1B1B28" />
            <SolidColorBrush x:Key="CardBorder" Color="#353549" />
            <SolidColorBrush x:Key="SubtleText" Color="#B4B3CA" />
            <SolidColorBrush x:Key="AccentText" Color="#C2B3FF" />
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowHeader" Background="#151520">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0" VerticalAlignment="Center">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="7" Canvas.Top="7" Width="242" Height="242" RadiusX="57" RadiusY="57"
                                   Fill="#2D214A" Stroke="#64518B" StrokeThickness="5" />
                        <Path Data="M 57,169 L 113,104 L 155,142 L 199,78" Stroke="#CFBCFF" StrokeThickness="16" />
                        <Ellipse Canvas.Left="45" Canvas.Top="157" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                        <Ellipse Canvas.Left="101" Canvas.Top="92" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                        <Ellipse Canvas.Left="143" Canvas.Top="130" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                        <Ellipse Canvas.Left="187" Canvas.Top="66" Width="24" Height="24" Fill="#2D214A" Stroke="#CFBCFF" StrokeThickness="8" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="RouteFinder" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="PreviewLabel" Text="DESIGN PREVIEW" Foreground="{StaticResource AccentText}" FontSize="10"
                           FontWeight="SemiBold" CharacterSpacing="100" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="24,14,24,16" MaxWidth="1100" RowSpacing="10" SizeChanged="ResizeCards">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="App router" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Grid x:Name="HeaderActions" Grid.Column="1" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button x:Name="WindowsRoutingButton" Content="Windows routing" Click="OpenWindowsRouting" />
                    <Button x:Name="ActivityButton" Grid.Column="1" Content="Activity" Click="OpenActivity" />
                    <Button x:Name="SettingsButton" Grid.Column="2" Content="Settings" Click="OpenSettings" />
                    <Button x:Name="AdvancedButton" Grid.Column="3" Content="Advanced tools" Click="OpenAdvancedTools" />
                </Grid>
            </Grid>

            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" />
            <Grid x:Name="Cards" Grid.Row="2" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition x:Name="RouteColumn" Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" /><RowDefinition x:Name="StackedRouteRow" Height="0" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="What to route" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="AddAppsButton" Grid.Column="2" Content="Add app">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Choose a running app" Click="PickRunningApp" />
                                        <MenuFlyoutItem Text="Choose a background process" Click="PickBackgroundApp" />
                                        <MenuFlyoutItem Text="Browse for an executable…" Click="BrowseForApp" />
                                        <MenuFlyoutItem x:Name="CatalogCommand" Text="Browse EZConnect game and app catalog…" Click="OpenCatalog" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="PresetsButton" Grid.Column="1" Content="Presets" Click="OpenPresets" />
                        </Grid>
                        <RadioButtons x:Name="Scope" Grid.Row="1" MaxColumns="2" SelectedIndex="0" SelectionChanged="ScopeChanged"
                                      AutomationProperties.Name="Traffic scope">
                            <x:String>Selected apps</x:String>
                            <x:String>Entire PC</x:String>
                            <x:String>Selected apps only</x:String>
                        </RadioButtons>
                        <TextBlock x:Name="AppSummary" Grid.Row="2" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="AppScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="AppRows" Spacing="5" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="VerificationScroller" Grid.Row="3" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                        <Border Grid.Row="4" Background="#242437" CornerRadius="12" Padding="12,9">
                            <StackPanel Spacing="5">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Live connection" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Polyline x:Name="LatencyTrend" Grid.Column="1" Width="94" Height="20" Stroke="#C3B1FF"
                                              StrokeThickness="1.8" Visibility="Collapsed"
                                              ToolTipService.ToolTip="Recent WireSock peer RTT estimates. The scale adjusts to the visible range." />
                                    <Button x:Name="VerifyRoutingButton" Grid.Column="2" Content="Verify routing" Click="ToggleRoutingVerification" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Peer RTT" Foreground="{StaticResource SubtleText}" FontSize="11" /><TextBlock x:Name="LiveRtt" Text="—" FontSize="19" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Est. loss" Foreground="{StaticResource SubtleText}" FontSize="11" /><TextBlock x:Name="LiveLoss" Text="—" FontSize="19" /></StackPanel>
                                    <StackPanel Grid.Column="2" ToolTipService.ToolTip="Mean change between consecutive WireSock RTT estimates. This is an estimate trend, not packet-level jitter."><TextBlock Text="RTT variation" Foreground="{StaticResource SubtleText}" FontSize="11" /><TextBlock x:Name="LiveVariation" Text="—" FontSize="19" /></StackPanel>
                                </Grid>
                                <TextBlock x:Name="LiveUsage" Text="Connect to see tunnel traffic." Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LivePeer" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                <HyperlinkButton x:Name="HealthAlert" Visibility="Collapsed" Click="OpenActivity" Padding="0,2"
                                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <TextBlock x:Name="HealthMessage" TextWrapping="Wrap" Foreground="#FFC085" />
                                </HyperlinkButton>
                                <StackPanel x:Name="InlineConnectionActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                    <Button x:Name="ReconnectInline" Content="Reconnect" Click="ReconnectFromPanel" />
                                    <Button x:Name="WatchInline" Content="Watch apps" Click="WatchFromPanel" />
                                    <Button x:Name="HoldInline" Content="Hold open" Click="HoldFromPanel" />
                                    <Button x:Name="HotspotInline" Content="Hotspot" Click="HotspotFromPanel" />
                                    <Button x:Name="ProbeInline" Content="Probe" Click="ProbeFromPanel" />
                                    <Button x:Name="ResetInline" Content="Reset TCP" Click="ResetFromPanel" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="RouteCard" Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
                    <Grid RowSpacing="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Where to connect" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button x:Name="AddRouteButton" Grid.Column="1" Content="Add route">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="ImportRouteCommand" Text="Import WireGuard or Amnezia configuration…" Click="ImportConfig" />
                                        <MenuFlyoutItem x:Name="AccountCommand" Text="Sign in to EZConnect…" Click="ToggleAccount" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBox x:Name="RouteSearch" Grid.Row="1" PlaceholderText="Search routes, regions, or sources" AutomationProperties.Name="Search routes" />
                        <Grid x:Name="RouteFilters" Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RouteFilter" HorizontalAlignment="Stretch" AutomationProperties.Name="Route source" />
                            <ComboBox x:Name="RouteRegion" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Route region" />
                            <ComboBox x:Name="RouteSort" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort routes" />
                            <ToggleButton x:Name="RouteFavorites" Grid.Column="3" Content="☆" AutomationProperties.Name="Favorites only" ToolTipService.ToolTip="Favorites only" />
                        </Grid>
                        <ListView x:Name="RouteList" Grid.Row="3" ItemTemplate="{StaticResource RoutePickerRowTemplate}" AutomationProperties.Name="Available routes">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <StackPanel x:Name="EmptyRouteLibrary" Grid.Row="3" Spacing="6" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="No routes yet" FontWeight="SemiBold" />
                            <TextBlock Text="Use Add route to import a configuration or sign in to a route provider." TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleText}" />
                        </StackPanel>
                        <TextBlock x:Name="RouteListSummary" Grid.Row="4" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                        <Grid x:Name="InternetAdapterRow" Grid.Row="5" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Internet adapter" VerticalAlignment="Center" />
                            <Button x:Name="InternetAdapterButton" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Click="OpenInternetAdapter" AutomationProperties.Name="Internet adapter">
                                <TextBlock x:Name="InternetAdapterLabel" Text="Automatic" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="RouteTestActions" Grid.Row="6" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="TestRouteButton" Content="Test route" Click="TestSelectedRoute" />
                            <Button x:Name="TestAllButton" Content="Test all routes" Click="TestAllRoutes" />
                            <Button x:Name="RouteToolsButton" AutomationProperties.Name="More route tools"
                                    ToolTipService.ToolTip="More route tools">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="TestShortlistButton" Text="Test filtered routes…" Click="TestShortlist" />
                                        <MenuFlyoutItem x:Name="CompareButton" Text="Compare routes" Click="CompareRoutes">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="DestinationButton" Text="Test destination…" Click="TestCustomDestination">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="RouteOptionsButton" Text="Route options" Click="OpenRouteOptions">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="WindowsRoutingPanel" Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Windows app routing" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="WindowsRoutingStatus" Foreground="{StaticResource AccentText}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="WindowsDefaultAdapter" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <ComboBox x:Name="WindowsFallbackAdapter" Header="Default adapter for unassigned apps"
                                  HorizontalAlignment="Stretch" SelectionChanged="WindowsFallbackChanged" />
                    </StackPanel>
                    <StackPanel x:Name="WindowsRoutingTools" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BrowseWindowsAppsButton" Content="Browse for apps…" Click="BrowseWindowsApps" />
                        <Button x:Name="RefreshWindowsAdaptersButton" Content="Refresh adapters" Click="RefreshWindowsAdapters" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Button Content="Routing profiles…" Click="ManageAppRoutingProfiles" />
                        <Button Content="Live routing inspector…" Click="InspectAppRouting" />
                        <Button Content="Interfaces and DNS…" Click="ManageInterfaces" />
                    </StackPanel>
                    <TextBlock Text="Choose an internet adapter for each app" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel x:Name="WindowsAppRows" Spacing="8" />
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WindowsRoutingHint" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartWindowsRoutingButton" Content="Save &amp; apply" Style="{StaticResource AccentButtonStyle}" Click="ToggleWindowsRouting" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ConnectionBar" Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Background="#28203D">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionTitle" Text="Disconnected" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ConnectionDetail" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="ConnectionActionsButton" Grid.Column="1" Click="OpenConnectionOptions"
                            AutomationProperties.Name="Connection options" ToolTipService.ToolTip="Connection options">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                    <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Click="ToggleConnection"
                            Style="{StaticResource AccentButtonStyle}" Background="#C3B1FF" Foreground="#201638"
                            MinWidth="100" Padding="12,8" CornerRadius="9" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
