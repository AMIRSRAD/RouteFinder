<Application x:Class="RouteFinder.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                RouteFinder brand: violet into cyan. The accent colors here reach every control; the accent
                brushes and button gradients are set on the window root in MainWindow.xaml so control templates use them.
            -->
            <Color x:Key="BrandViolet">#FF7C5CFF</Color>
            <Color x:Key="BrandBlue">#FF4F7DFF</Color>
            <Color x:Key="BrandCyan">#FF22D3EE</Color>

            <!-- Softer corners on every control and flyout. -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

            <!-- Filled tile for page headers and providers: brand gradient with a white glyph. -->
            <LinearGradientBrush x:Key="BrandSolid" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource BrandViolet}" Offset="0" />
                <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrandRing" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource BrandViolet}" Offset="0" />
                <GradientStop Color="{StaticResource BrandBlue}" Offset="0.5" />
                <GradientStop Color="{StaticResource BrandCyan}" Offset="1" />
            </LinearGradientBrush>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#FF7C66F5</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF9784FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFB3A6FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFD3CCFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF6A52EC</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF5340C8</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF3A2C96</Color>

                    <!-- Primary buttons: a diagonal violet-to-blue gradient. -->

                    <!-- Glass cards: a faint violet-tinted fill with a brighter top edge. -->
                    <LinearGradientBrush x:Key="BrandCardFill" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#16FFFFFF" Offset="0" />
                        <GradientStop Color="#0C9C8CFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandCardEdge" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#0DFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandTileFill" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#337C5CFF" Offset="0" />
                        <GradientStop Color="#2222D3EE" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandTitleText" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#FFCDC4FF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandBanner" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#407C5CFF" Offset="0" />
                        <GradientStop Color="#1A22D3EE" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                    <Color x:Key="BrandGlowViolet">#2E7C5CFF</Color>
                    <Color x:Key="BrandGlowCyan">#1C22D3EE</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FF5B44D6</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF7C66F5</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF9784FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFB3A6FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF4E39C4</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF3F2DA3</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF2E2079</Color>

                    <LinearGradientBrush x:Key="BrandCardFill" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#E6F5F3FF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandCardEdge" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14000000" Offset="0" />
                        <GradientStop Color="#24000000" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandTileFill" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#265B44D6" Offset="0" />
                        <GradientStop Color="#1A0EA5C9" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandTitleText" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF17142E" Offset="0" />
                        <GradientStop Color="#FF4532B0" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandBanner" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E7C5CFF" Offset="0" />
                        <GradientStop Color="#140EA5C9" Offset="0.55" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <Color x:Key="BrandGlowViolet">#1F7C5CFF</Color>
                    <Color x:Key="BrandGlowCyan">#140EA5C9</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
