<Application x:Class="RouteFinder.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                RouteFinder look: one calm indigo accent on neutral surfaces. No gradients on text or buttons.
                The accent colors here reach every control; the accent brushes and button fills are set on the
                window root in MainWindow.xaml so control templates use them.
            -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <!-- Title bar logo. -->
            <SolidColorBrush x:Key="BrandSolid" Color="#FF4F63E0" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#FF5A6EE8</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF7186F0</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF92A3F5</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFB7C3FA</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF4C5FD6</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF3E4FBA</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF2F3D94</Color>

                    <!-- Neutral cards with a hairline edge that is slightly brighter at the top. -->
                    <SolidColorBrush x:Key="BrandCardFill" Color="#0FFFFFFF" />
                    <LinearGradientBrush x:Key="BrandCardEdge" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1FFFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="BrandTileFill" Color="#245A6EE8" />
                    <SolidColorBrush x:Key="BrandMetricFill" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="BrandTitleText" Color="#FFFFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FF3F51D6</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF5A6EE8</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF7186F0</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF92A3F5</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF3747C2</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF2D3BA3</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF232E80</Color>

                    <SolidColorBrush x:Key="BrandCardFill" Color="#CCFFFFFF" />
                    <LinearGradientBrush x:Key="BrandCardEdge" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F000000" Offset="0" />
                        <GradientStop Color="#1C000000" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="BrandTileFill" Color="#173F51D6" />
                    <SolidColorBrush x:Key="BrandMetricFill" Color="#08000000" />
                    <SolidColorBrush x:Key="BrandTitleText" Color="#E4000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
